# ── Development ──────────────────────────────────────────────────────────────
# Leave this commented out in development.
# Vite proxy (vite.config.js) will forward /api requests to localhost:5001.
# VITE_API_BASE_URL=

# ── Production ───────────────────────────────────────────────────────────────
# Set this to your deployed backend URL when deploying (e.g. on Vercel/Netlify).
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
